# PostgreSQL Connection String (Required in production)
DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST:5432/demandiq?sslmode=require"

# JWT Signing Configuration (Use a strong random 32+ char string in production)
JWT_SECRET_KEY="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated allowed CORS origins for the frontend
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app"

# Optional Gemini API key for natural-language narrative enrichment in AI Decision Center
GEMINI_API_KEY=""

# Business Policy Defaults
MIN_PROFIT_MARGIN_PCT=10.0
